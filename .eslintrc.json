{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "@next/next/no-img-element": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "smart"],
    "no-throw-literal": "error"
  },
  "ignorePatterns": ["node_modules/", ".next/", "android/", "public/sw.js", "scripts/"]
}
