# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fintrack"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""          # openssl rand -base64 32

# ─── OAuth (optional — remove if not using) ──────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Plaid ───────────────────────────────────────────────────────────────────
# Get these from dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=""
PLAID_SECRET=""             # Use the sandbox secret while testing
PLAID_ENV="sandbox"         # sandbox | development | production

# ─── Encryption (for storing Plaid access tokens at rest) ────────────────────
ENCRYPTION_KEY=""           # openssl rand -hex 32

# ─── Anthropic Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Cheaper model for high-volume transaction categorisation
ANTHROPIC_CATEGORIZE_MODEL="claude-sonnet-5"

# ─── Email ────────────────────────────────────────────────────────────────────
# Preferred: a transactional provider with an authenticated sending domain.
# Password resets and verification links land in spam from consumer SMTP.
# Set RESEND_API_KEY and the SMTP block below is ignored.
RESEND_API_KEY=""          # re_... from resend.com

# ─── Email (SMTP fallback, used when RESEND_API_KEY is empty) ─────────────────
# Uses Gmail SMTP by default — works with App Passwords.
# For other providers, change SMTP_HOST / SMTP_PORT accordingly.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@fintrack.app"

# ─── Push Notifications (VAPID) ───────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@fintrack.app"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Without these the limiter falls back to per-instance memory, which does not
# hold across serverless instances. Required in production.
# Create a database at console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` to
# /api/cron/daily. Without it the endpoint returns 503 and no jobs run.
CRON_SECRET=""             # openssl rand -hex 32

# ─── Stripe billing ───────────────────────────────────────────────────────────
# Price IDs come from the Stripe dashboard → Products. The amounts in
# src/lib/plans.ts are display-only; Stripe is what actually charges.
STRIPE_SECRET_KEY=""       # sk_test_... in test mode
STRIPE_WEBHOOK_SECRET=""   # whsec_... from `stripe listen` or the dashboard
STRIPE_PRICE_PLUS=""       # price_... for the Plus tier
STRIPE_PRICE_PRO=""        # price_... for the Pro tier

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"           # debug | info | warn | error
LOG_SERVICE_NAME="fintrack"

# ─── Error monitoring (Sentry) ────────────────────────────────────────────────
# All optional — with no DSN the SDK is inert and the app behaves as before.
SENTRY_DSN=""                        # server + edge
NEXT_PUBLIC_SENTRY_DSN=""            # browser
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Only needed to upload source maps at build time:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
